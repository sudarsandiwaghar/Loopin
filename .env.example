# GEMINI_API_KEY: Optional - used for automated risk scoring and policy summaries.
GEMINI_API_KEY="your-gemini-api-key"

# APP_URL: The URL where this app is hosted (e.g., https://your-project.vercel.app or http://localhost:3000)
APP_URL="http://localhost:3000"

# SUPABASE CONFIGURATION: Connects Loopin backend with your Supabase Cloud PostgreSQL database
# Get these from your Supabase Dashboard -> Project Settings -> API
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-public-key"
# SUPABASE_SERVICE_ROLE_KEY: Optional - used for administrative migrations and bypassing RLS
# SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# SERVER CONFIGURATION
PORT=3000
NODE_ENV="development"
